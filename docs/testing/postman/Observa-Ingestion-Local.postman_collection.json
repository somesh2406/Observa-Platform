      "name": "P01 - Liveness",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/cloudevents+json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health/live",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health",
            "live"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
