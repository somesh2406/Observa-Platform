# Health endpoints are deliberately separate from the JWT-protected event route.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: observa-health
spec:
  parentRefs:
    - name: observa-edge
  hostnames:
    - "${OBSERVA_GATEWAY_HOST}"
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /health/
      backendRefs:
        - name: observa-ingestion
          port: 8080
