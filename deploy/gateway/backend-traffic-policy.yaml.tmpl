apiVersion: gateway.envoyproxy.io/v1alpha1
kind: BackendTrafficPolicy
metadata:
  name: observa-ingestion-edge-limit
spec:
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: HTTPRoute
      name: observa-ingestion
  rateLimit:
    global:
      rules:
        - limit:
            requests: ${OBSERVA_EDGE_RATE_LIMIT_REQUESTS}
            unit: ${OBSERVA_EDGE_RATE_LIMIT_UNIT}
          shared: true
