# Edge authentication: use your trusted OIDC/JWT issuer in the real environment.
OBSERVA_JWT_ISSUER=https://pahalssouat.nimblelos.com/
OBSERVA_JWT_AUDIENCE=observa-gateway
OBSERVA_JWKS_URL=https://pahalssouat.nimblelos.com:8091/oidc/jwks
OBSERVA_JWKS_HOST=pahalssouat.nimblelos.com
OBSERVA_JWKS_PORT=8091
OBSERVA_GATEWAY_HOST=observa.example.com

# Edge-wide coarse abuse limit (shared by the Envoy rate-limit service and Redis).
OBSERVA_EDGE_RATE_LIMIT_REQUESTS=100
OBSERVA_EDGE_RATE_LIMIT_UNIT=Second
OBSERVA_GATEWAY_RATE_LIMIT_POLICY_PATH=deploy/gateway/backend-traffic-policy.yaml.tmpl

# Ingestion business quota. Local Compose uses memory; production should use Redis.
OBSERVA_TENANT_RATE_LIMIT_REQUESTS=100
OBSERVA_TENANT_RATE_LIMIT_WINDOW=1m
OBSERVA_TENANT_RATE_LIMIT_REDIS_ADDRESS=127.0.0.1:6379
OBSERVA_TENANT_RATE_LIMIT_REDIS_DB=0
OBSERVA_TENANT_RATE_LIMIT_REDIS_TLS=false
OBSERVA_TENANT_RATE_LIMIT_DIAL_TIMEOUT=2s
OBSERVA_TENANT_RATE_LIMIT_REDIS_USERNAME=
# Set only if your Redis deployment requires authentication.
OBSERVA_TENANT_RATE_LIMIT_REDIS_PASSWORD=

# Local TLS certificate paths (self-signed development-only certificate).
OBSERVA_GATEWAY_TLS_CERT_FILE=../gateway/local/tls.crt
OBSERVA_GATEWAY_TLS_KEY_FILE=../gateway/local/tls.key
